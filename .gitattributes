# Normaliza los finales de línea en el repositorio.
# Sin esto, el mismo archivo aparece como modificado según si se editó en Windows o en Linux.
* text=auto

*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.html text eol=lf

*.png binary
*.jpg binary
*.webp binary
*.pdf binary
*.xlsx binary
